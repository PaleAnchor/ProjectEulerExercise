    "import re\n",
    "name_loc=r\"C:\\Users\\V\\Documents\\欧拉计划\\ProjectEulerExercise\\数据\\x.txt\"\n",
    "with open(name_loc) as f:\n",
    "    content = f.read()\n",
    "pattern = r'\"[^\"]*\"'\n",
    "result = re.findall(pattern, content)\n",
    "\n",
    "name_list=[]\n",
    "for idx, content in enumerate(result, 1):\n",
    "    name_list.append(content)    \n"
   ]
  }
