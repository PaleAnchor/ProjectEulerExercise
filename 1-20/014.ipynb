   "source": [
    "out=[0,0]\n",
    "for i in range(2,1000000):\n",
    "    num=i\n",
    "    step=0\n",
    "    while(num!=1):\n",
    "        if num%2==0:\n",
    "            num=num/2\n",
    "            step=step+1\n",
    "        else:\n",
    "            num=num*3+1\n",
    "            step=step+1\n",
    "    if step>out[0]:\n",
    "        out=[step,i]\n",
    "print(out[1])"
   ]
  }
