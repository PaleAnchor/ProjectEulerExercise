    "with open(\"Project Euler/数据/013.txt\",\"r\") as file:\n",
    "    data=[int(i) for i in [i.replace(\"\\n\",\"\") for i in file.readlines()]]\n",
    "    sum=0\n",
    "    for i in range(len(data)):\n",
    "        sum=sum+data[i]\n",
    "    print(str(sum)[0:10])"
   ]
