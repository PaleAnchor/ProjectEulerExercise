   "source": [
    "def SpiralDiagonalsSum(n:int):\n",
    "    spiralnum_list=[1]\n",
    "    num_zushu=int((n-1)/2)\n",
    "    for i in range(num_zushu):\n",
    "        for j in range(4):\n",
    "            spiralnum_list.append(spiralnum_list[-1]+2*(i+1))\n",
    "    return sum(spiralnum_list)\n",
    "\n",
    "print(SpiralDiagonalsSum(1001))"
   ]
  }
